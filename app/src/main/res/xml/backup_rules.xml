<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 backup rules; see data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="file" path="clipboard_history.json" />
    <exclude domain="file" path="clipboard_history.json.tmp" />
    <exclude domain="file" path="swipe_user_words.txt" />
    <exclude domain="file" path="swipe_user_words.txt.tmp" />
    <!-- ~77 MB Whisper model: re-downloadable, and alone it blows the 25 MB
         Auto Backup quota, which makes the whole backup (settings too) fail. -->
    <exclude domain="file" path="models/" />
</full-backup-content>
